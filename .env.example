# Copy this file to .env and fill in your own values.
# Get a free Groq API key at https://console.groq.com/keys

GROQ_API_KEY=your_key_here
# Groq retires/renames models fairly often - if you get a 404 "model not
# found" error, check https://console.groq.com/docs/models for current names.
GROQ_MODEL=openai/gpt-oss-20b

# Local embedding model (downloaded once from Hugging Face, then cached).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where ChromaDB stores its persistent data on disk.
CHROMA_PATH=./chroma_db
COLLECTION_NAME=mythology_universe

# Ingestion (document splitting) settings.
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval settings.
TOP_K=5
RELEVANCE_THRESHOLD=0.25

# How many previous Q&A turns to keep as conversation memory.
MAX_HISTORY_TURNS=4

# Used to sign Flask session cookies (conversation memory). Set this to a
# random string in any real deployment.
FLASK_SECRET_KEY=dev-secret-change-me
